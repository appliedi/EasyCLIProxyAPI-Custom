{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EasyCLIProxyAPI Custom",
  "mainBinaryName": "EasyCLIProxyAPI",
  "bundle": {
    "targets": ["nsis"],
    "publisher": "EasyCLIProxyAPI Custom",
    "shortDescription": "Desktop console for CLIProxyAPI",
    "licenseFile": "../LICENSE",
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "installerHooks": "windows/installer-hooks.nsh"
      }
    }
  }
}
